# Copy to .env.local and fill in. Names only here, never values.

# Luke AI. Without it /api/chat returns a broken stream and the dock shows
# its error state; the rest of the site is unaffected.
ANTHROPIC_API_KEY=

# Optional. Overrides the model /api/chat streams (default: claude-sonnet-5).
# LUKE_AI_MODEL=claude-haiku-4-5

# Password for the gated case study. No default in the source on purpose:
# the gate fails closed when this is unset, so an unconfigured deploy hides
# the draft rather than publishing it.
CASE_STUDY_GATE_PASSWORD=

# Product analytics. Safe to leave blank in development.
NEXT_PUBLIC_POSTHOG_KEY=
